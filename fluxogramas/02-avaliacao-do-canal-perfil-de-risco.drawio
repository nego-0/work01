0;entryDy=0;" edge="1" parent="1" source="b15" target="b16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b18" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt0" value="PRAZOS: no dia; participação ao contencioso em 2 dias.&#10;Nota — Os passageiros passam pelo canal verde quando nada têm a declarar e pelo canal vermelho sempre que tenham mercadorias por declarar. Mesmo optando pelo canal verde, o passageiro pode ser encaminhado para a sala de verificação em função do perfil de risco ou de selecção aleatória.&#10;Nota — No desembaraço de bagagens comerciais emite-se primeiro a nota de liquidação e só depois se rastreia a bagagem por raio-X. Verificando-se falsas declarações, realiza-se a inspecção física, apura-se a irregularidade, emenda-se o processo e este segue para contencioso." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9D6;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="823" width="900" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
