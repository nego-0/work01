  <diagram id="pg-p02" name="AVALIAÇÃO DO CANAL PARA TRAMITAÇÃO COM BASE NO PER"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pool" value="AVALIAÇÃO DO CANAL PARA TRAMITAÇÃO COM BASE NO PERFIL DE RISCO — CONTROLO DE PESSOAS E BAGAGENS" style="swimlane;html=1;horizontal=0;startSize=32;fillColor=none;strokeColor=#000000;fontSize=12;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="3412" height="753" as="geometry"/></mxCell><mxCell id="lane0" value="Passageiro" style="swimlane;html=1;horizontal=0;startSize=130;fillColor=none;strokeColor=#000000;fontSize=11;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="pool"><mxGeometry x="32" y="0" width="3380" height="282" as="geometry"/></mxCell><mxCell id="lane1" value="Técnico Aduaneiro" style="swimlane;html=1;horizontal=0;startSize=130;fillColor=none;strokeColor=#000000;fontSize=11;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="pool"><mxGeometry x="32" y="282" width="3380" height="157" as="geometry"/></mxCell><mxCell id="lane2" value="Sala de Verificação" style="swimlane;html=1;horizontal=0;startSize=130;fillColor=none;strokeColor=#000000;fontSize=11;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="pool"><mxGeometry x="32" y="439" width="3380" height="157" as="geometry"/></mxCell><mxCell id="lane3" value="Contencioso" style="swimlane;html=1;horizontal=0;startSize=130;fillColor=none;strokeColor=#000000;fontSize=11;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="pool"><mxGeometry x="32" y="596" width="3380" height="157" as="geometry"/></mxCell><mxCell id="b1" value="Passageiro no Sistema Duplo Canal" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" p