thogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k23" target="k24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed27" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k22" target="k24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k24" target="k25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k25" target="k26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k26" target="k27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt0" value="PRAZO: no dia.&#10;Nota 1 — As bagagens de interesse aduaneiro, antes da inspeção, podem ser novamente rastreadas; não havendo necessidade de abrir, dá-se continuidade ao processo.&#10;Nota 2 — Quando necessário, as bagagens acompanhadas podem ser repassadas no raio-X da sala de desembarque.&#10;&#10;FUNDAMENTO DOS PASSOS ACRESCENTADOS (lilás): Convenção de Quioto Revista, Anexo Específico J, Capítulo 1 (viajantes, duplo canal, franquias); Acordo sobre a Facilitação do Comércio da OMC (gestão de risco, informação prévia, direito de reclamação e recurso); Quadro Normativo SAFE da OMA (informação antecipada, inspeção não intrusiva); Acordo de Valoração Aduaneira da OMC (valor transaccional); Código Aduaneiro e Pauta Aduaneira de Angola; normas cambiais aplicáveis à entrada e saída de divisas; CITES, Convenção de Basileia e IATA-DGR para mercadorias restritas e perigosas." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9D6;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1185" width="900" height="170" as="geometry"/></mxCell><mxCell id="leg" value="LEGENDA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="980" y="1185" width="360" height="110" as="geometry"/></mxCell><mxCell id="leg1" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="992" y="1211" width="24" height="16" as="geometry"/></mxCell><mxCell id="leg1t" value="Passo descrito no documento de procedimentos" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1024" y="1211" width="300" height="16" as="geometry"/></mxCell><mxCell id="leg2" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="992" y="1237" width="24" height="16" as="geometry"/></mxCell><mxCell id="leg2t" value="Passo acrescentado por aplicação de normas aduaneiras nacionais e internacionais e por inferência lógica" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1024" y="1231" width="310" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram>
