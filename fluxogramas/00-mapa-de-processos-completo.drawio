;fontSize=10;fontStyle=1;" vertex="1" parent="lane1"><mxGeometry x="240" y="62.5" width="40" height="40" as="geometry"/></mxCell><mxCell id="d2" value="Pesar, fotografar e descrever a mercadoria à entrada" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="375" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d3" value="Registar a entrada com os números de etiquetas" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="575" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d4" value="Alocar a bagagem na prateleira do respectivo voo" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="775" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d5" value="Emitir o termo de entrada / guia de depósito" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="975" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d6" value="X" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;fontColor=#7F7F00;" vertex="1" parent="lane1"><mxGeometry x="1236" y="58.5" width="48" height="48" as="geometry"/></mxCell><mxCell id="d6_cap" value="Tipo de levantamento" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane1"><mxGeometry x="1175" y="109.5" width="170" height="34" as="geometry"/></mxCell><mxCell id="d7" value="Solicitar por escrito o levantamento, com reconhecimento notarial" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane0"><mxGeometry x="1375" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d8" value="Apresentar a justificação do motivo de o titular não levantar a bagagem" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane0"><mxGeometry x="1575" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d9" value="Dar entrada do pedido na Administração e aguardar resposta" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane4"><mxGeometry x="1775" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d10" value="X" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;fontColor=#7F7F00;" vertex="1" parent="lane4"><mxGeometry x="2036" y="58.5" width="48" height="48" as="geometry"/></mxCell><mxCell id="d10_cap" value="Pedido autorizado?" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane4"><mxGeometry x="1975" y="109.5" width="170" height="34" as="geometry"/></mxCell><mxCell id="d11" value="Pedido Indeferido" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane4"><mxGeometry x="2240" y="62.5" width="40" height="40" as="geometry"/></mxCell><mxCell id="d12" value="Assinar o termo de autorização" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane3"><mxGeometry x="2175" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d13" value="Acompanhar a deslocação da bagagem para armazém de acesso