ar a bagagem (só o técnico pode tatear a bagagem)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="1975" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="c11" value="Lavrar o termo de verificação e recolher a assinatura do titular" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="2175" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="c12" value="X" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;fontColor=#7F7F00;" vertex="1" parent="lane2"><mxGeometry x="2436" y="58.5" width="48" height="48" as="geometry"/></mxCell><mxCell id="c12_cap" value="Mercadorias de interesse aduaneiro?" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane2"><mxGeometry x="2375" y="109.5" width="170" height="34" as="geometry"/></mxCell><mxCell id="c13" value="Recompor a bagagem e devolvê-la ao titular" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="2575" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="c14" value="Liberar a bagagem" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="2775" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="c15" value="Bagagem Liberada" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane1"><mxGeometry x="3040" y="62.5" width="40" height="40" as="geometry"/></mxC