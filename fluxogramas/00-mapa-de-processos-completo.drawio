0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="d9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed9" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="d10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d10" target="d11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d11" target="d12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d12" target="d13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d13" target="d14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt0" value="PRAZOS: registo e liberação no dia; levantamento em nome de outrem até 3 dias úteis.&#10;Nota 1 — Em caso de tratamento de bagagem em nome de outrem, o despachante oficial está autorizado a regularizar ou levantar a bagagem, desde que devidamente identificado (cartão de praticante de despachante oficial e bilhete de identidade).&#10;Nota 2 — Procedimento para levantar em nome de outrem: solicitação por escrito reconhecida em notário; justificação do motivo de o titular não levantar a bagagem; entrada na Administração; aguardar resposta.&#10;Nota 3 — Mercadoria de valor superior ao equivalente a 5.000 USD obriga a desembaraço por despachante oficial (ver processo 1 — Análise documental)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9D6;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1012" width="980" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram>
