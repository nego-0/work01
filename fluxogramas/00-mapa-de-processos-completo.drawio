=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d13" target="d14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d14" target="d15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed15" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d15" target="d16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d16" target="d17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed17" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d15" target="d18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d18" target="d19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d19" target="d20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d20" target="d21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d21" target="d22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt0" value="PRAZOS: registo e liberação no dia; levantamento em nome de outrem até 3 dias úteis.&#10;Nota 1 — Em caso de tratamento de bagagem em nome de outrem, o despachante oficial está autorizado a regularizar ou levantar a bagagem, desde que devidamente identificado (cartão de praticante de despachante oficial e bilhete de identidade).&#10;Nota 2 — Procedimento para levantar em nome de outrem: solicitação por escrito reconhecida em notário; justificação do motivo de o titular não levantar a bagagem; entrada na Administração; aguardar resposta.&#10;Nota 3 — Mercadoria de valor superior ao equivalente a 5.000 USD obriga a desembaraço por despachante oficial (ver processo 1 — Análise documental).&#10;&#10;FUNDAMENTO DOS PASSOS ACRESCENTADOS (lilás): Convenção de Quioto Revista, Anexo Específico J, Capítulo 1 (viajantes, duplo canal, franquias); Acordo sobre a Facilitação do Comércio da OMC (gestão de risco, informação prévia, direito de reclamação e recurso); Quadro Normativo SAFE da OMA (informação antecipada, inspeção não intrusiva); Acordo de Valoração Aduaneira da OMC (valor transaccional); Código Aduaneiro e Pauta Aduaneira de Angola; normas cambiais aplicáveis à entrada e saída de divisas; CITES, Convenção de Basileia e IATA-DGR para mercadorias restritas e perigosas." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9D6;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1092" width="980" height="200" as="geometry"/></mxCell><mxCell id="leg" value="LEGENDA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1060" y="1092" width="360" height="110" as="geometry"/></mxCell><mxCell id="leg1" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1072" y="1118" width="24" height="16" as="geometry"/></mxCell><mxCell id="leg1t" value="Passo descrito no documento de procedimentos" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1104" y="1118" width="300" height="16" as="geometry"/></mxCell><mxCell id="leg2" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1072" y="1144" width="24" height="16" as="geometry"/></mxCell><mxCell id="leg2t" value="Passo acrescentado por aplicação de normas aduaneiras nacionais e internacionais e por inferência lógica" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1104" y="1138" width="310" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram>
