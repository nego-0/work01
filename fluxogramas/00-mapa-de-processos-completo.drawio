 e aplicar a selecção aleatória" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="1375" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="b9" value="X" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;fontColor=#7F7F00;" vertex="1" parent="lane1"><mxGeometry x="1636" y="58.5" width="48" height="48" as="geometry"/></mxCell><mxCell id="b9_cap" value="Seleccionado para verificação?" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane1"><mxGeometry x="1575" y="109.5" width="170" height="34" as="geometry"/></mxCell><mxCell id="b10" value="Passageiro Liberado" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane0"><mxGeometry x="1840" y="62.5" width="40" height="40" as="geometry"/></mxCell><mxCell id="b11" value="Encaminhar à sala de verificação (técnico identificado com passe de serviço da AGT e passe de acesso da ATO)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="1775" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="b12" value="Informar o passageiro do motivo do controlo e dos seus direitos" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="1975" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="b13" value="Verificar as bagagens e realizar a entrevista, quando necessário" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1"