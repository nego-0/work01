#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane0"><mxGeometry x="1375" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d8" value="Apresentar a justificação do motivo de o titular não levantar a bagagem" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane0"><mxGeometry x="1575" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d9" value="Dar entrada do pedido na Administração e aguardar resposta" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane4"><mxGeometry x="1775" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d10" value="X" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;fontColor=#7F7F00;" vertex="1" parent="lane4"><mxGeometry x="2036" y="58.5" width="48" height="48" as="geometry"/></mxCell><mxCell id="d10_cap" value="Pedido autorizado?" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane4"><mxGeometry x="1975" y="109.5" width="170" height="34" as="geometry"/></mxCell><mxCell id="d11" value="Pedido Indeferido" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane4"><mxGeometry x="2240" y="62.5" width="40" height="40" as="geometry"/></mxCell><mxCell id="d12" value="Assinar o termo de autorização" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane3"><mxGeometry x="2175" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d13" value="Acompanhar a deslocação da bagagem para armazém de acesso ao solicitante" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane5"><mxGeometry x="2375" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d14" value="Conferir a identificação do levantador (documento de identificação e cartão de despachante)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="2575" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d15" value="X" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;fontColor=#7F7F00;" vertex="1" parent="lane1"><mxGeometry x="2836" y="58.5" width="48" height="48" as="geometry"/></mxCell><mxCell id="d15_cap" value="Prazo de permanência em armazém excedido?" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane1"><mxGeometry x="2775" y="109.5" width="170" height="34" as="geometry"/></mxCell><mxCell id="d16" value="Aplicar o regime de mercadoria abandonada e remeter para venda ou perdimento a favor do Estado" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane3"><mxGeometry x="2975" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d17" value="Mercadoria Abandonada" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane3"><mxGeometry x="3240" y="62.5" width="40" height="40" as="geometry"/></mxCell><mxCell id="d18" value="Emitir a nota de desalfandegamento" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="2975" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d19" value="Conferir a mercadoria com o titular no acto da entrega" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="3175" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d20" value="Registar no livro a saída da mercadoria" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="3375" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d21" value="Recolher a assinatura de entrega e arquivar o comprovativo" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="3575" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="d22" value="Mercadoria Liberada" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane2"><mxGeometry x="3840" y="62.5" width="40" height="40" as="geometry"/></mxCell><mxCell id="ed0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell