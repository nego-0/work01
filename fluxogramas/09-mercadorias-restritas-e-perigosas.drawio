 value="Registar a apreensão no livro e assegurar a cadeia de custódia" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="1775" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="j10" value="Instruir o processo de contencioso" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane4"><mxGeometry x="1975" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="j11" value="Mercadoria Apreendida e Entregue ao Órgão de Tutela" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="lane4"><mxGeometry x="2240" y="62.5" width="40" height="40" as="geometry"/></mxCell><mxCell id="j12" value="Reter a bagagem" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="775" y="175.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="j13" value="Emitir o termo de retenção e informar o prazo para regularização" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="975" y="175.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="j14" value="Apresentar a certificação de autorização da mercadoria" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="lane0"><mxGeometry x="1175" y="50.5" width="170" height="64" as="geometry"/></mxCell><mxCell id="j15" value="X" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=