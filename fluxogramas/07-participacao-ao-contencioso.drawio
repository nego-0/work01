 edge="1" parent="1" source="h9" target="h12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h12" target="h13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h13" target="h14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h14" target="h15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt0" value="PRAZO: no dia.&#10;Documentos que instruem a participação: sinopse, auto de apreensão, participação ao Cartório e formulário de ocorrência.&#10;&#10;FUNDAMENTO DOS PASSOS ACRESCENTADOS (lilás): Convenção de Quioto Revista, Anexo Específico J, Capítulo 1 (viajantes, duplo canal, franquias); Acordo sobre a Facilitação do Comércio da OMC (gestão de risco, informação prévia, direito de reclamação e recurso); Quadro Normativo SAFE da OMA (informação antecipada, inspeção não intrusiva); Acordo de Valoração Aduaneira da OMC (valor transaccional); Código Aduaneiro e Pauta Aduaneira de Angola; normas cambiais aplicáveis à entrada e saída de divisas; CITES, Convenção de Basileia e IATA-DGR para mercadorias restritas e perigosas." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9D6;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="860" height="160" as="geometry"/></mxCell><mxCell id="leg" value="LEGENDA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="1060" width="360" height="110" as="geometry"/></mxCell><mxCell id="leg1" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="952" y="1086" width="24" height="16" as="geometry"/></mxCell><mxCell id="leg1t" value="Passo descrito no documento de procedimentos" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="984" y="1086" width="300" height="16" as="geometry"/></mxCell><mxCell id="leg2" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="952" y="1112" width="24" height="16" as="geometry"/></mxCell><mxCell id="leg2t" value="Passo acrescentado por aplicação de normas aduaneiras nacionais e internacionais e por inferência lógica" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="984" y="1106" width="310" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram>
